<style>
@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@700;900&family=Share+Tech+Mono&family=Inter:wght@400;600;700;800&display=swap');

*{margin:0;padding:0;box-sizing:border-box;}
body{
  background:#06090F;
  font-family:'Inter',sans-serif;
  color:#E2E8F0;
  padding:0;
}

/* ══ OUTER WRAPPER ══ */
.page{
  width:720px;
  margin:0 auto;
  background:
    radial-gradient(ellipse 80% 40% at 50% 0%, rgba(0,180,216,.07) 0%, transparent 70%),
    radial-gradient(ellipse 60% 30% at 20% 100%, rgba(255,107,53,.05) 0%, transparent 60%),
    #06090F;
  padding-bottom:36px;
}

/* ══ HEADER ══ */
.header{
  position:relative;
  background:linear-gradient(160deg,#07131F 0%,#0A1D2E 60%,#060E18 100%);
  border-bottom:2px solid #00B4D8;
  overflow:hidden;
  padding:32px 40px 28px;
  text-align:center;
}
.header::before{
  content:'';position:absolute;top:-80px;left:50%;transform:translateX(-50%);
  width:700px;height:400px;
  background:radial-gradient(ellipse,rgba(0,180,216,.12) 0%,transparent 65%);
  pointer-events:none;
}
.header::after{
  content:'';position:absolute;bottom:0;left:0;right:0;height:2px;
  background:linear-gradient(90deg,transparent,#00B4D8 30%,#FFD700 50%,#00B4D8 70%,transparent);
}
.match-pill{
  display:inline-flex;align-items:center;gap:8px;
  background:rgba(255,107,53,.1);border:1px solid rgba(255,107,53,.35);
  border-radius:999px;padding:5px 18px;
  font-family:'Share Tech Mono',monospace;font-size:11px;
  color:#FF6B35;letter-spacing:2px;text-transform:uppercase;margin-bottom:14px;
}
.match-pill-dot{width:6px;height:6px;border-radius:50%;background:#FF6B35;animation:blink 1.8s infinite;}
@keyframes blink{0%,100%{opacity:1;}50%{opacity:.2};}

.h-title{
  font-family:'Orbitron',sans-serif;font-weight:900;
  font-size:30px;letter-spacing:-0.5px;line-height:1;
  background:linear-gradient(90deg,#fff 0%,#00B4D8 45%,#FFD700 75%,#fff 100%);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
}
.h-sub{
  font-family:'Orbitron',sans-serif;font-size:13px;font-weight:700;
  color:#00B4D8;letter-spacing:3px;text-transform:uppercase;margin-top:6px;
}
.h-match{
  margin-top:14px;display:inline-flex;align-items:center;gap:0;
  background:rgba(0,0,0,.35);border:1px solid rgba(255,255,255,.08);
  border-radius:10px;overflow:hidden;font-size:13px;font-weight:700;
}
.h-team{padding:8px 20px;letter-spacing:.5px;}
.h-team.sa{color:#40C057;}
.h-team.uy{color:#74C0FC;}
.h-vs{
  padding:8px 10px;background:rgba(255,215,0,.08);
  font-family:'Orbitron',sans-serif;font-size:11px;color:#FFD700;font-weight:900;
  border-left:1px solid rgba(255,255,255,.07);border-right:1px solid rgba(255,255,255,.07);
}
.h-result{padding:8px 14px;background:rgba(34,197,94,.08);
  color:#22C55E;font-family:'Share Tech Mono',monospace;font-size:12px;
  border-left:1px solid rgba(255,255,255,.07);}

/* ══ STATS ROW ══ */
.stats-row{
  display:flex;justify-content:center;gap:0;
  border-bottom:1px solid #111E2E;
  background:rgba(0,180,216,.03);
}
.st{
  flex:1;text-align:center;padding:14px 8px;
  border-right:1px solid #111E2E;
}
.st:last-child{border-right:none;}
.st-val{font-family:'Orbitron',sans-serif;font-size:22px;font-weight:700;color:#00B4D8;}
.st-lbl{font-family:'Share Tech Mono',monospace;font-size:9px;color:#4A6580;letter-spacing:2px;text-transform:uppercase;margin-top:2px;}

/* ══ PODIUM ══ */
.podium-wrap{
  display:flex;align-items:flex-end;justify-content:center;
  gap:12px;padding:28px 40px 8px;
}
.pod{display:flex;flex-direction:column;align-items:center;flex:1;max-width:180px;}
.pod-crown{font-size:22px;margin-bottom:4px;}
.pod-name{font-size:12px;font-weight:800;text-align:center;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:100%;margin-bottom:3px;}
.pod-pts-label{font-family:'Share Tech Mono',monospace;font-size:10px;color:#4A6580;margin-bottom:7px;}
.pod-block{width:100%;display:flex;align-items:center;justify-content:center;
  font-family:'Orbitron',sans-serif;font-weight:900;font-size:26px;border-radius:8px 8px 0 0;}
.pod1 .pod-name{color:#FFD700;}
.pod1 .pod-block{height:110px;background:linear-gradient(180deg,rgba(255,215,0,.18),rgba(255,215,0,.03));border:1px solid rgba(255,215,0,.3);color:#FFD700;}
.pod2 .pod-name{color:#C0C0C0;}
.pod2 .pod-block{height:82px;background:linear-gradient(180deg,rgba(192,192,192,.15),rgba(192,192,192,.02));border:1px solid rgba(192,192,192,.25);color:#C0C0C0;}
.pod3 .pod-name{color:#CD7F32;}
.pod3 .pod-block{height:64px;background:linear-gradient(180deg,rgba(205,127,50,.15),rgba(205,127,50,.02));border:1px solid rgba(205,127,50,.25);color:#CD7F32;}

/* ══ NEW SECTION (acertantes highlight) ══ */
.new-section{
  margin:16px 32px;
  background:linear-gradient(135deg,rgba(34,197,94,.08),rgba(0,180,216,.06));
  border:1px solid rgba(34,197,94,.2);border-radius:12px;padding:14px 18px;
}
.new-title{
  font-family:'Share Tech Mono',monospace;font-size:9px;
  color:#22C55E;letter-spacing:2px;text-transform:uppercase;margin-bottom:10px;
  display:flex;align-items:center;gap:6px;
}
.new-title::after{content:'';flex:1;height:1px;background:rgba(34,197,94,.2);}
.new-chips{display:flex;flex-wrap:wrap;gap:6px;}
.new-chip{
  font-size:12px;font-weight:700;padding:4px 14px;border-radius:999px;
  background:rgba(34,197,94,.12);border:1px solid rgba(34,197,94,.3);color:#22C55E;
  display:flex;align-items:center;gap:5px;
}
.new-chip-arrow{font-size:10px;color:rgba(34,197,94,.6);}

/* ══ RANKING TABLE ══ */
.rank-section{padding:0 32px;}

.tier-hdr{
  display:flex;align-items:center;gap:10px;
  padding:14px 0 6px;
  font-family:'Share Tech Mono',monospace;font-size:9px;
  color:#4A6580;letter-spacing:2.5px;text-transform:uppercase;
}
.tier-hdr::after{content:'';flex:1;height:1px;background:#111E2E;}

.row{
  display:grid;grid-template-columns:38px 24px 1fr 42px;
  align-items:center;padding:7px 10px;gap:6px;
  border-radius:6px;margin-bottom:2px;
  transition:background .1s;
  border:1px solid transparent;
}
.row:hover{background:rgba(255,255,255,.025);}
.row.acertante{
  background:rgba(34,197,94,.04);
  border-color:rgba(34,197,94,.12);
}
.r-pos{font-family:'Share Tech Mono',monospace;font-size:11px;color:#4A6580;text-align:center;}
.r-icon{font-size:12px;text-align:center;}
.r-name{font-size:12px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.r-pts{font-family:'Orbitron',sans-serif;font-size:13px;font-weight:700;text-align:right;}
.r-new{font-family:'Share Tech Mono',monospace;font-size:8px;color:#22C55E;
  background:rgba(34,197,94,.1);border:1px solid rgba(34,197,94,.2);
  border-radius:4px;padding:1px 5px;margin-left:4px;}

/* Tier colors */
.tg .r-pts{color:#FFD700;}  .tg .r-pos{color:#A0822A;}
.tf .r-pts{color:#FF6B35;}  .tf .r-pos{color:#7A4020;}
.tl .r-pts{color:#00B4D8;}  .tl .r-pos{color:#1A5566;}
.tt .r-pts{color:#A78BFA;}  .tt .r-pos{color:#4A3A7A;}
.tz .r-pts{color:#FACC15;}  .tz .r-pos{color:#6A5010;}
.th .r-pts{color:#94A3B8;}  .th .r-pos{color:#3A4A5A;}
.tr .r-pts{color:#EF4444;}  .tr .r-pos{color:#6A2020;}
.tr .r-name{opacity:.7;}

/* ══ FOOTER ══ */
.footer{
  text-align:center;padding:20px 32px 0;
