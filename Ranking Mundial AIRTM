.footer strong{color:#00B4D8;}
.footer-line{
  display:flex;align-items:center;justify-content:center;gap:16px;
  margin-top:10px;flex-wrap:wrap;
}
.f-pill{background:#0D1B2A;border:1px solid #111E2E;border-radius:6px;padding:5px 14px;font-size:9px;letter-spacing:1px;}

</style>
